# DecMET local environment example.
# Production and Preview values must be configured in Vercel Environment Variables.
# Never commit real credentials or API keys.

# =========================
# Runtime
# =========================
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://decmet.com.br
FRONTEND_ORIGIN=http://localhost:3000

# =========================
# Aiven MySQL
# Required for /api/aeroportos/**
# =========================
DB_HOST=your-aiven-host.example
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=decmet_airports
DB_SSL=true

# Optional serverless pool tuning
DB_CONNECTION_LIMIT=2
DB_MAX_IDLE=1
DB_IDLE_TIMEOUT=5000
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# =========================
# REDEMET / DECEA API
# Required for preferred routing of ICAO codes starting with S.
# Keep this key only on the backend/Vercel environment.
# =========================
REDEMET_API_KEY=your_redemet_api_key
REDEMET_BASE_URL=https://api-redemet.decea.mil.br
REDEMET_REQUEST_TIMEOUT=10000

# =========================
# NOAA AviationWeather
# All values below are optional because the code has safe defaults.
# =========================
AVIATION_WEATHER_BASE_URL=https://aviationweather.gov/api/data
AVIATION_WEATHER_USER_AGENT=DecMET/1.0
NOAA_USER_AGENT=DecMET/1.0
NOAA_REQUEST_TIMEOUT=10000

# =========================
# METAR cache
# Best-effort in-memory cache per warm serverless instance.
# =========================
METAR_CACHE_TTL_SECONDS=60
